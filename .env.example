# 默认配置可在没有 API Key、没有 Milvus 的电脑上直接运行
DOCPILOT_MODE=demo
DOCPILOT_VECTOR_BACKEND=memory
DOCPILOT_AI_BACKEND=deterministic

# 检索与切分
DOCPILOT_COLLECTION_NAME=docpilot_chunks
DOCPILOT_CHUNK_SIZE=500
DOCPILOT_CHUNK_OVERLAP=50
DOCPILOT_TOP_K=5
DOCPILOT_SIMILARITY_THRESHOLD=0.5
DOCPILOT_EMBEDDING_DIMENSION=1536

# production 模式：复制本文件为 .env 后填写
DOCPILOT_MILVUS_URI=http://localhost:19530
DOCPILOT_MILVUS_TOKEN=
DOCPILOT_DASHSCOPE_API_KEY=
DOCPILOT_EMBEDDING_MODEL=text-embedding-v1
DOCPILOT_CHAT_MODEL=qwen-plus

# 本地路径导入用于 demo；部署为远程服务时建议改为 false。上传大小默认 20 MiB
DOCPILOT_ALLOW_LOCAL_PATHS=true
DOCPILOT_MAX_UPLOAD_BYTES=20971520

